{
  "dependencies_to_add": {
    "kafkajs": "^2.2.4",
    "neo4j-driver": "^5.14.0",
    "@pinecone-database/pinecone": "^1.1.0",
    "ws": "^8.14.2",
    "ioredis": "^5.3.2"
  },
  "devDependencies_to_add": {
    "@types/ws": "^8.5.8"
  },
  "scripts_to_add": {
    "kafka:start": "docker-compose up -d kafka zookeeper",
    "neo4j:start": "docker-compose up -d neo4j",
